# Optional: defaults to PyRo1121.
GITHUB_USERNAME=PyRo1121

# Recommended for authenticated rate limits and private activity visibility.
# Create a read-only token with the smallest permissions your dashboard needs.
# In production, store this with `wrangler secret put GITHUB_TOKEN`; never add it to wrangler.jsonc.
GITHUB_TOKEN=

# Optional second fine-grained token for exact private organization repositories.
# Both values are required together. Keep the allowlist explicit and the token read-only.
# Production: `wrangler secret put GITHUB_ORGANIZATION_TOKEN`.
GITHUB_ORGANIZATION_REPOSITORIES=CodeLoud/codeloud,CodeLoud/codeloud-voice,CodeLoud/codeloud-relay
GITHUB_ORGANIZATION_TOKEN=

# Cloudflare account inventory and analytics. Keep the token server-side.
# Production: `wrangler secret put CLOUDFLARE_API_TOKEN`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Exact Cloudflare Access owner allowed to read and mutate the Career workspace.
CAREER_OWNER_EMAIL=olen@latham.cloud

# Public Access application identifiers used to verify Cf-Access-Jwt-Assertion.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=

# Shared secret for the /__warm cron refresh endpoint. Same value on the main
# Worker and the weeknote-warm scheduled Worker. Production: `wrangler secret put WARM_SECRET`
# on both workers; never add it to wrangler.jsonc.
WARM_SECRET=
