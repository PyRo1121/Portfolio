{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "weeknote",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-13",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "gh.latham.cloud",
			"custom_domain": true
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"kv_namespaces": [
		{
			"binding": "WEEKNOTE_CACHE",
			"id": "70db94b6340347d0b6a1f7ce236b7cff"
		}
	],
	"d1_databases": [
		{
			"binding": "CAREER_DB",
			"database_name": "weeknote-career",
			"database_id": "2e37016a-ccb2-4a3d-b4fd-7010c7addf54",
			"migrations_dir": "migrations/career"
		}
	],
	"vars": {
		"CAREER_OWNER_EMAIL": "olen@latham.cloud",
		"CLOUDFLARE_ACCOUNT_ID": "f1e95b3e1b502cf366dfc81a863695fa",
		"GITHUB_CHECKS_APP_ID": "4598962",
		"GITHUB_CHECKS_INSTALLATION_ID": "153820305",
		"GITHUB_USERNAME": "PyRo1121"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
