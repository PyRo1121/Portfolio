{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "weeknote-warm",
	"main": "index.js",
	"compatibility_date": "2026-08-13",
	"workers_dev": false,
	"triggers": {
		"crons": ["*/10 * * * *", "15 0 * * *"]
	},
	"services": [
		{
			"binding": "WEEKNOTE",
			"service": "weeknote"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
